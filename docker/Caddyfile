{$DOMAIN} {
    encode zstd gzip

    handle /api/* {
        reverse_proxy api:8080
    }

    handle /docs* {
        reverse_proxy api:8080
    }

    handle /openapi.json {
        reverse_proxy api:8080
    }

    handle /health {
        reverse_proxy api:8080
    }

    handle {
        root * /srv
        file_server
    }
}
